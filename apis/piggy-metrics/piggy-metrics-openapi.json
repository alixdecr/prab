{
    "openapi": "3.0.0",
    "info": {
        "title": "Piggy Metrics",
        "version": "1.1.0",
        "description": "OpenAPI Specification for Piggy Metrics, a simple financial advisor app built to demonstrate the Microservice Architecture Pattern using Spring Boot, Spring Cloud and Docker. This file was created by the PRAB (Public REST API Benchmark) developers. Revised against upstream sqshq/piggymetrics master: gateway routes (/uaa, /accounts, /statistics, /notifications/recipients), corrected notifications recipients path and host port."
    },
    "servers": [
        {
            "url": "http://localhost:80",
            "description": "Local deployment via docker-compose (API Gateway listens on container port 4000, published as host port 80)."
        }
    ],
    "paths": {
        "/uaa/users": {
            "post": {
                "description": "Register a new user account (auth-service UserController).",
                "responses": {
                    "200": {
                        "description": "Valid request."
                    },
                    "default": {
                        "description": "Invalid request."
                    }
                }
            }
        },

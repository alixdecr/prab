  "paths": {
    "/v1/restrooms/by_date": {
      "get": {
        "description": "Search for restroom records updated or created on or after a given date",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            },
            "in": "query",
            "name": "page",
            "description": "Page offset to fetch.",
            "required": false
          },
          {
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 10
            },
            "in": "query",
            "name": "per_page",
            "description": "Number of results to return per page.",
            "required": false
          },
          {
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0
            },
            "in": "query",
            "name": "offset",
            "description": "Pad a number of results.",
            "required": false
          },
          {
            "schema": {
              "type": "boolean"
            },
            "in": "query",
            "name": "ada",
            "description": "Only return restrooms that are ADA accessible.",
            "required": false
          },
          {
            "schema": {
              "type": "boolean"
            },
            "in": "query",
            "name": "unisex",
            "description": "Only return restrooms that are unisex.",
            "required": false
          },
          {
            "schema": {
              "type": "boolean"
            },
            "in": "query",
            "name": "updated",
            "description": "Return restroom records updated (rather than created) since given date",
            "required": false
          },
          {
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "in": "query",
            "name": "day",
            "description": "Day",
            "required": true
          },
          {
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "in": "query",
            "name": "month",
            "description": "Month",
            "required": true
          },
          {
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "in": "query",
            "name": "year",
            "description": "Year",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Search for restroom records updated or created on or after a given date"
          }
        },
        "tags": [
          "restrooms"
        ],
        "operationId": "getV1RestroomsByDate"
      }
    },

{
    "openapi": "3.0.0",
    "info": {
        "title": "Random User Generator API",
        "version": "1.4",
        "description": "A free and easy to use service to generate random user data for application testing.\n\nSend all requests to `https://randomuser.me/api/`. Access a specific API version that won't be affected by updates via `https://randomuser.me/api/1.4/`.\n\nDocumentation: https://randomuser.me/documentation",
        "contact": {
            "name": "Random User Generator",
            "url": "https://randomuser.me"
        }
    },
    "servers": [
        {
            "url": "https://randomuser.me"
        }
    ],
    "paths": {
        "/api/": {
            "get": {
                "summary": "Generate random user(s)",
                "description": "Returns one or more randomly generated users using the latest API version. By default one user is returned; use `results` for up to 5,000 per request.",
                "operationId": "getRandomUsers",
                "parameters": [
                    { "$ref": "#/components/parameters/Results" },
                    { "$ref": "#/components/parameters/Gender" },
                    { "$ref": "#/components/parameters/Password" },
                    { "$ref": "#/components/parameters/Seed" },
                    { "$ref": "#/components/parameters/Format" },
                    { "$ref": "#/components/parameters/Nat" },
                    { "$ref": "#/components/parameters/Page" },
                    { "$ref": "#/components/parameters/Inc" },
                    { "$ref": "#/components/parameters/Exc" },
                    { "$ref": "#/components/parameters/Dl" },
                    { "$ref": "#/components/parameters/Noinfo" },
                    { "$ref": "#/components/parameters/Callback" }
                ],
                "responses": {
                    "200": {
                        "description": "Generated user data. Format depends on the `format` parameter.",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/Response" }
                            },
                            "application/xml": {
                                "schema": { "type": "string" }
                            },
                            "text/csv": {
                                "schema": { "type": "string" }
                            },
                            "application/x-yaml": {
                                "schema": { "type": "string" }
                            }
                        }
                    },
                    "default": {
                        "description": "API error.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string",
                                            "example": "Uh oh, something has gone wrong. Please tweet us @randomapi about the issue. Thank you."
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/{version}/": {
            "get": {
                "summary": "Generate random user(s) using a specific API version",
                "description": "Same as `/api/`, but pinned to a specific API version so results are not affected by future updates.",
                "operationId": "getRandomUsersVersioned",
                "parameters": [
                    {
                        "name": "version",
                        "in": "path",
                        "required": true,
                        "description": "API version to use.",
                        "schema": {
                            "type": "string",
                            "enum": ["1.0", "1.1", "1.2", "1.3", "1.4"]
                        }
                    },
                    { "$ref": "#/components/parameters/Results" },
                    { "$ref": "#/components/parameters/Gender" },
                    { "$ref": "#/components/parameters/Password" },
                    { "$ref": "#/components/parameters/Seed" },
                    { "$ref": "#/components/parameters/Format" },
                    { "$ref": "#/components/parameters/Nat" },
                    { "$ref": "#/components/parameters/Page" },
                    { "$ref": "#/components/parameters/Inc" },
                    { "$ref": "#/components/parameters/Exc" },
                    { "$ref": "#/components/parameters/Dl" },
                    { "$ref": "#/components/parameters/Noinfo" },
                    { "$ref": "#/components/parameters/Callback" }
                ],
                "responses": {
                    "200": {
                        "description": "Generated user data. Format depends on the `format` parameter.",
                        "content": {
                            "application/json": {
                                "schema": { "$ref": "#/components/schemas/Response" }
                            },
                            "application/xml": {
                                "schema": { "type": "string" }
                            },
                            "text/csv": {
                                "schema": { "type": "string" }
                            },
                            "application/x-yaml": {
                                "schema": { "type": "string" }
                            }
                        }
                    },
                    "default": {
                        "description": "API error.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": { "type": "string" }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "parameters": {
            "Results": {
                "name": "results",
                "in": "query",
                "required": false,
                "description": "Number of users to generate in one request (up to 5,000).",
                "schema": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5000,
                    "default": 1
                }
            },
            "Gender": {
                "name": "gender",
                "in": "query",
                "required": false,
                "description": "Generate only male or only female users. Any other value returns both.",
                "schema": {
                    "type": "string",
                    "enum": ["male", "female"]
                }
            },
            "Password": {
                "name": "password",
                "in": "query",
                "required": false,
                "description": "Control password generation: `CHARSETS,MIN_LENGTH-MAX_LENGTH` or `CHARSETS,MAX_LENGTH`. Charsets (mixable): special, upper, lower, number. Default: 8-64 chars chosen from a list of ~10k top used passwords.",
                "schema": {
                    "type": "string",
                    "example": "upper,lower,1-16"
                }
            },
            "Seed": {
                "name": "seed",
                "in": "query",
                "required": false,
                "description": "Any string or sequence of characters; the same seed always generates the same set of users (for a given version).",
                "schema": {
                    "type": "string"
                }
            },
            "Format": {
                "name": "format",
                "in": "query",
                "required": false,
                "description": "Data format to return.",
                "schema": {
                    "type": "string",
                    "enum": ["json", "prettyjson", "pretty", "csv", "yaml", "xml"],
                    "default": "json"
                }
            },
            "Nat": {
                "name": "nat",
                "in": "query",
                "required": false,
                "description": "Nationality/nationalities of the generated users (comma-separated). Random nationalities by default. v1.4 supports: AU, BR, CA, CH, DE, DK, ES, FI, FR, GB, IE, IN, IR, MX, NL, NO, NZ, RS, TR, UA, US.",
                "schema": {
                    "type": "string",
                    "example": "us,dk,fr,gb"
                }
            },
            "Page": {
                "name": "page",
                "in": "query",
                "required": false,
                "description": "1-based page index for requesting multiple pages of a seed. Use the same seed and page number to get back the same results.",
                "schema": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 1
                }
            },
            "Inc": {
                "name": "inc",
                "in": "query",
                "required": false,
                "description": "Comma-delimited list of fields to include. Accepts: gender, name, location, email, login, registered, dob, phone, cell, id, picture, nat.",
                "schema": {
                    "type": "string",
                    "example": "gender,name,nat"
                }
            },
            "Exc": {
                "name": "exc",
                "in": "query",
                "required": false,
                "description": "Comma-delimited list of fields to exclude. Accepts: gender, name, location, email, login, registered, dob, phone, cell, id, picture, nat.",
                "schema": {
                    "type": "string",
                    "example": "login"
                }
            },
            "Dl": {
                "name": "dl",
                "in": "query",
                "required": false,
                "description": "Download the results with the appropriate format extension.",
                "schema": {
                    "type": "string",
                    "enum": [""]
                }
            },
            "Noinfo": {
                "name": "noinfo",
                "in": "query",
                "required": false,
                "description": "Return only the data, omitting seed, results, page and version info.",
                "schema": {
                    "type": "string",
                    "enum": [""]
                }
            },
            "Callback": {
                "name": "callback",
                "in": "query",
                "required": false,
                "description": "JSONP callback name. Only available with JSON formats.",
                "schema": {
                    "type": "string"
                }
            }
        },
        "schemas": {
            "Response": {
                "type": "object",
                "properties": {
                    "results": {
                        "type": "array",
                        "items": { "$ref": "#/components/schemas/User" }
                    },
                    "info": { "$ref": "#/components/schemas/Info" }
                }
            },
            "Info": {
                "type": "object",
                "description": "Omitted when the `noinfo` parameter is used.",
                "properties": {
                    "seed": {
                        "type": "string",
                        "description": "Seed used to generate the results."
                    },
                    "results": {
                        "type": "integer",
                        "description": "Number of results returned."
                    },
                    "page": {
                        "type": "integer",
                        "description": "Page returned."
                    },
                    "version": {
                        "type": "string",
                        "description": "API version used."
                    }
                }
            },
            "User": {
                "type": "object",
                "properties": {
                    "gender": {
                        "type": "string",
                        "enum": ["male", "female"]
                    },
                    "name": {
                        "type": "object",
                        "properties": {
                            "title": { "type": "string" },
                            "first": { "type": "string" },
                            "last": { "type": "string" }
                        }
                    },
                    "location": {
                        "type": "object",
                        "properties": {
                            "street": {
                                "type": "object",
                                "properties": {
                                    "number": { "type": "integer" },
                                    "name": { "type": "string" }
                                }
                            },
                            "city": { "type": "string" },
                            "state": { "type": "string" },
                            "country": { "type": "string" },
                            "postcode": { "type": "string" },
                            "coordinates": {
                                "type": "object",
                                "properties": {
                                    "latitude": { "type": "string" },
                                    "longitude": { "type": "string" }
                                }
                            },
                            "timezone": {
                                "type": "object",
                                "properties": {
                                    "offset": { "type": "string" },
                                    "description": { "type": "string" }
                                }
                            }
                        }
                    },
                    "email": { "type": "string" },
                    "login": {
                        "type": "object",
                        "properties": {
                            "uuid": { "type": "string" },
                            "username": { "type": "string" },
                            "password": { "type": "string" },
                            "salt": { "type": "string" },
                            "md5": { "type": "string" },
                            "sha1": { "type": "string" },
                            "sha256": { "type": "string" }
                        }
                    },
                    "dob": { "$ref": "#/components/schemas/DatedAge" },
                    "registered": { "$ref": "#/components/schemas/DatedAge" },
                    "phone": { "type": "string" },
                    "cell": { "type": "string" },
                    "id": {
                        "type": "object",
                        "properties": {
                            "name": { "type": "string" },
                            "value": { "type": "string" }
                        }
                    },
                    "picture": {
                        "type": "object",
                        "properties": {
                            "large": { "type": "string", "format": "uri" },
                            "medium": { "type": "string", "format": "uri" },
                            "thumbnail": { "type": "string", "format": "uri" }
                        }
                    },
                    "nat": { "type": "string" }
                }
            },
            "DatedAge": {
                "type": "object",
                "properties": {
                    "date": {
                        "type": "string",
                        "description": "ISO 8601 date."
                    },
                    "age": { "type": "integer" }
                }
            }
        }
    }
}

{
    "openapi": "3.1.1",
    "info": {
        "title": "OMDb API",
        "version": "1.0",
        "description": "The OMDb API is a RESTful web service to obtain movie information, all content and images on the site are contributed and maintained by our users.\n\nSend all data requests to `https://www.omdbapi.com/?apikey=[yourkey]&`. At least one of `i`, `t`, or `s` is required per request:\n- **By ID or Title**: use `i` (a valid IMDb ID) and/or `t` (movie title)\n- **By Search**: use `s` (movie title to search for)\n- **Seasons/Episodes**: combine `Season` and optionally `Episode` with `t` or `i`\n\nAn API key is required and can be requested for free at https://www.omdbapi.com/apikey.aspx (free keys have a 1,000 daily request limit).",
        "termsOfService": "https://www.omdbapi.com/legal.htm",
        "contact": {
            "email": "bfritz@fadingsignal.com"
        },
        "license": {
            "name": "CC BY-NC 4.0",
            "url": "https://creativecommons.org/licenses/by-nc/4.0/"
        }
    },
    "servers": [
        {
            "url": "https://www.omdbapi.com"
        },
        {
            "url": "http://www.omdbapi.com"
        }
    ],
    "paths": {
        "/": {
            "get": {
                "summary": "Retrieve or search movie information",
                "description": "Single endpoint for all data requests. Provide an IMDb ID (`i`) or title (`t`) to retrieve a single item, or a search term (`s`) with optional paging to search. `Season` (and optionally `Episode`) may be combined with `t` or `i` to return season or single-episode data for series.",
                "operationId": "getMovies",
                "parameters": [
                    {
                        "name": "apikey",
                        "in": "query",
                        "required": true,
                        "description": "Your API key, obtained at https://www.omdbapi.com/apikey.aspx.",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "i",
                        "in": "query",
                        "description": "A valid IMDb ID (e.g. tt1285016). At least one of `i`, `t`, or `s` is required.",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "t",
                        "in": "query",
                        "description": "Movie title to search for. At least one of `i`, `t`, or `s` is required.",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "s",
                        "in": "query",
                        "description": "Movie title to search for. At least one of `i`, `t`, or `s` is required.",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "type",
                        "in": "query",
                        "description": "Type of result to return.",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "movie",
                                "series",
                                "episode"
                            ]
                        }
                    },
                    {
                        "name": "y",
                        "in": "query",
                        "description": "Year of release.",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "plot",
                        "in": "query",
                        "description": "Return short or full plot.",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "short",
                                "full"
                            ],
                            "default": "short"
                        }
                    },
                    {
                        "name": "r",
                        "in": "query",
                        "description": "The data type to return.",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "json",
                                "xml"
                            ],
                            "default": "json"
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Page number to return (search results only).",
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 100,
                            "default": 1
                        }
                    },
                    {
                        "name": "Season",
                        "in": "query",
                        "description": "Season number; combine with `t` or `i` to return all episodes in a season.",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "Episode",
                        "in": "query",
                        "description": "Episode number; combine with `Season` and `t` or `i` to return a single episode.",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "callback",
                        "in": "query",
                        "description": "JSONP callback name.",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "v",
                        "in": "query",
                        "description": "API version (reserved for future use).",
                        "schema": {
                            "type": "integer",
                            "default": 1
                        }
                    }
                ]
            }
        }
    }
}

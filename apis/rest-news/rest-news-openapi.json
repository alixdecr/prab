{
  "openapi": "3.1.1",
  "info": {
    "description": "Some description",
    "version": "2.0.0",
    "title": "API for REST News"
  },
  "servers": [
    {
      "url": "http://localhost:8080/"
    }
  ],
  "tags": [
    {
      "name": "country-api",
      "description": "API for country data."
    },
    {
      "name": "news-rest-api",
      "description": "Handling of creating and retrieving news"
    }
  ],
  "paths": {
    "/countries": {
      "get": {
        "tags": [
          "country-api"
        ],
        "summary": "Retrieve list of country names",
        "operationId": "getUsingGET",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          }
        },
        "deprecated": false
      }
    },
    "/news": {
      "get": {
        "tags": [
          "news-rest-api"
        ],
        "summary": "Get all the news",
        "operationId": "getUsingGET_1",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "name": "authorId",
            "in": "query",
            "description": "The id of the author who wrote the news",
            "required": false,
            "allowEmptyValue": false
          },
          {
            "schema": {
              "type": "string"
            },
            "name": "country",
            "in": "query",
            "description": "The country name",
            "required": false,
            "allowEmptyValue": false
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/vnd.tsdes.news+json;charset=UTF-8;version=2": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/NewsDto"
                  }
                }
              },
              "application/json;charset=UTF-8": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/NewsDto"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          }
        },
        "deprecated": false
      },
      "post": {
        "tags": [
          "news-rest-api"
        ],
        "summary": "Create a news",
        "operationId": "createNewsUsingPOST",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/vnd.tsdes.news+json;charset=UTF-8;version=2": {
                "schema": {
                  "type": "integer",
                  "format": "int64"
                }
              },
              "application/json;charset=UTF-8": {
                "schema": {
                  "type": "integer",
                  "format": "int64"
                }
              }
            }
          },
          "201": {
            "description": "Created"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          }
        },
        "deprecated": false,
        "requestBody": {
          "content": {
            "application/vnd.tsdes.news+json;charset=UTF-8;version=2": {
              "schema": {
                "$ref": "#/components/schemas/NewsDto"
              }
            },
            "application/json;charset=UTF-8": {
              "schema": {
                "$ref": "#/components/schemas/NewsDto"
              }
            }
          },
          "description": "Text of news, plus author id and country. Should not specify id or creation time",
          "required": false
        }
      }
    },
    "/news/{id}": {
      "get": {
        "tags": [
          "news-rest-api"
        ],
        "summary": "Get a single news specified by id",
        "operationId": "getNewsUsingGET",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "name": "id",
            "in": "path",
            "description": "The numeric id of the news",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/vnd.tsdes.news+json;charset=UTF-8;version=2": {
                "schema": {
                  "$ref": "#/components/schemas/NewsDto"
                }
              },
              "application/json;charset=UTF-8": {
                "schema": {
                  "$ref": "#/components/schemas/NewsDto"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          }
        },
        "deprecated": false
      },
      "put": {
        "tags": [
          "news-rest-api"
        ],
        "summary": "Update an existing news",
        "operationId": "updateUsingPUT",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "name": "id",
            "in": "path",
            "description": "The numeric id of the news",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/vnd.tsdes.news+json;charset=UTF-8;version=2": {
                "schema": {
                  "type": "object"
                }
              },
              "application/json;charset=UTF-8": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "201": {
            "description": "Created"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          }
        },
        "deprecated": false,
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewsDto"
              }
            }
          },
          "description": "The news that will replace the old one. Cannot change its id though.",
          "required": false
        }
      },
      "delete": {
        "tags": [
          "news-rest-api"
        ],
        "summary": "Delete a news with the given id",
        "operationId": "deleteUsingDELETE",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "name": "id",
            "in": "path",
            "description": "The numeric id of the news",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/vnd.tsdes.news+json;charset=UTF-8;version=2": {
                "schema": {
                  "type": "object"
                }
              },
              "application/json;charset=UTF-8": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "204": {
            "description": "No Content"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "deprecated": false
      }
    },
    "/news/{id}/text": {
      "put": {
        "tags": [
          "news-rest-api"
        ],
        "summary": "Update the text content of an existing news",
        "operationId": "updateTextUsingPUT",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "name": "id",
            "in": "path",
            "description": "The numeric id of the news",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/vnd.tsdes.news+json;charset=UTF-8;version=2": {
                "schema": {
                  "type": "object"
                }
              },
              "application/json;charset=UTF-8": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "201": {
            "description": "Created"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          }
        },
        "deprecated": false,
        "requestBody": {
          "content": {
            "text/plain": {
              "schema": {
                "type": "string"
              }
            }
          },
          "description": "The new text which will replace the old one",
          "required": false
        }
      }
    }
  },
  "components": {
    "schemas": {
      "NewsDto": {
        "type": "object",
        "properties": {
          "authorId": {
            "type": "string",
            "description": "The id of the author that wrote/created this news"
          },
          "country": {
            "type": "string",
            "description": "The country this news is related to"
          },
          "creationTime": {
            "type": "string",
            "format": "date-time",
            "description": "When the news was first created/published"
          },
          "id": {
            "type": "string",
            "description": "Deprecated. Use newsId instead"
          },
          "newsId": {
            "type": "string",
            "description": "The id of the news"
          },
          "text": {
            "type": "string",
            "description": "The text of the news"
          }
        },
        "title": "NewsDto"
      }
    }
  }
}
